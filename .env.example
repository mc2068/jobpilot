# InsForge backend (read automatically by @insforge/sdk/ssr)
NEXT_PUBLIC_INSFORGE_URL=your_insforge_url
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key

# Base URL used to build the OAuth /callback redirect (must be set in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog analytics (browser events, server events, server logs)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host

# Anthropic API key for every plain text AI call (lib/anthropic.ts). Server-side only
ANTHROPIC_API_KEY=your_anthropic_api_key
