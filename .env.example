# InsForge backend (read automatically by @insforge/sdk/ssr)
NEXT_PUBLIC_INSFORGE_URL=your_insforge_url
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key

# Base URL used to build the OAuth /callback redirect (must be set in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog analytics (browser events, server events, server logs)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host

# PostHog query API: reads events back for the dashboard charts (lib/posthog-query.ts).
# A personal API key with the query:read scope, and the project id. Server-side only
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key
POSTHOG_PROJECT_ID=your_posthog_project_id

# Anthropic API key for every plain text AI call (lib/anthropic.ts). Server-side only
ANTHROPIC_API_KEY=your_anthropic_api_key

# Adzuna job search API (lib/adzuna.ts). Server-side only
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Browserbase Fetch API: reads company website pages (lib/browserbase.ts). Server-side only
BROWSERBASE_API_KEY=your_browserbase_api_key
